#!/usr/bin/env bash
# site-tmux [site] — attach to (or create) the tmux session for <site>, in its folder.
#                    With no argument: opens a 'home' session in $HOME.
#   site-tmux --update — pull the latest dotfiles and re-run install.sh, then exit.
#
# Additive only: creating/attaching a tmux session does not affect any background services.
# Also ensures a `claude remote-control --name <site>` session is running in its own
# `claude-rc` window, so Claude is ready (controllable from claude.ai/code or the mobile
# app) right after open. If the site's directory has not yet been trusted in Claude, the
# window shows a one-time instruction instead — remote-control cannot start in an
# untrusted workspace, so run `claude` there once to accept the trust dialog.
#
# Two one-time consents gate remote-control; after each, it stays headless:
#   1. Per-directory workspace trust (above) — accept once per new site.
#   2. Per-machine "Enable Remote Control? (y/n)" — the first time remote-control runs on
#      a machine it asks this; answer `y` once (it persists as remoteDialogSeen in
#      ~/.claude.json and applies to every site afterwards).
#
# The site→directory map is per-machine and lives outside this repo at
#   ${XDG_CONFIG_HOME:-$HOME/.config}/site-tmux/sites.conf
# Format: one `site=dir` per line. '#' comments and blank lines are ignored.
# Unknown or missing sites fall back to $HOME, so the script is safe on any server.
set -euo pipefail

# --- self-update: resolve this script's real path → repo root → git pull + reinstall ---
if [[ "${1:-}" == "--update" ]]; then
    self="$(readlink -f "${BASH_SOURCE[0]}")"   # follows the install symlink into the repo
    repo="$(cd "$(dirname "$self")/.." && pwd)"  # bin/ → repo root
    if [[ ! -d "$repo/.git" ]]; then
        echo "site-tmux: --update needs a git checkout; $repo is not a git repo." >&2
        exit 1
    fi
    git -C "$repo" pull --ff-only
    exec "$repo/install.sh"
fi

site="${1:-${SITE:-}}"
config="${XDG_CONFIG_HOME:-$HOME/.config}/site-tmux/sites.conf"

# Resolve the working directory for this site.
dir=""
if [[ -n "$site" && -f "$config" ]]; then
    # match `site=dir`, tolerate surrounding whitespace; last match wins.
    while IFS='=' read -r key val; do
        key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"
        [[ -z "$key" || "$key" == \#* ]] && continue
        if [[ "$key" == "$site" ]]; then
            val="${val#"${val%%[![:space:]]*}"}"; val="${val%"${val##*[![:space:]]}"}"
            dir="${val/#\~/$HOME}"
        fi
    done < "$config"
fi

if [[ -z "$site" ]]; then
    site="home"; dir="$HOME"          # no arg → 'home' session in $HOME
elif [[ -z "$dir" ]]; then
    dir="$HOME"                       # unknown site → forgiving default
fi

# Resolve claude once, here, using this script's PATH — the remote-control window's own
# shell may not have ~/.local/bin yet (e.g. mid-install), so don't rely on it finding claude.
clbin="$(command -v claude || true)"

# Is <dir> already trusted in Claude? remote-control refuses to start in an untrusted
# workspace and there is no flag to bypass it, so we must check before launching.
# 0 = trusted, non-zero = not (or unknown). node ships with claude, so it's always present.
dir_trusted() {
    local d="$1" cfg="$HOME/.claude.json"
    [[ -f "$cfg" ]] || return 1
    node -e 'const fs=require("fs");const[c,d]=process.argv.slice(1);try{const j=JSON.parse(fs.readFileSync(c,"utf8"));process.exit(j.projects?.[d]?.hasTrustDialogAccepted===true?0:1)}catch{process.exit(1)}' "$cfg" "$d"
}

# Create the session (window 0 = shell) if it does not exist yet.
if ! tmux has-session -t "$site" 2>/dev/null; then
    tmux new-session -d -s "$site" -c "$dir"
fi

# Ensure the remote-control window (`claude-rc`) is present and alive; (re)create it when
# missing or when its pane has died. The distinct name + automatic-rename off keep it from
# colliding with the interactive shell window, which tmux auto-renames to `claude` once you
# start `claude` in it (that collision used to make this guard skip a dead RC window).
need_rc=1
if tmux list-windows -t "$site" -F '#{window_name}' 2>/dev/null | grep -qx claude-rc; then
    if [[ "$(tmux display -p -t "$site:claude-rc" '#{pane_dead}' 2>/dev/null)" == 1 ]]; then
        tmux kill-window -t "$site:claude-rc"
    else
        need_rc=0
    fi
fi

if [[ "$need_rc" == 1 ]]; then
    rclog="$HOME/.local/state/site-tmux"; mkdir -p "$rclog"
    # remain-on-exit keeps a crashed remote-control visible (with its error) instead of the
    # window silently vanishing; --debug-file persists why it exited.
    tmux new-window -d -t "$site" -c "$dir" -n claude-rc
    tmux set-window-option -t "$site:claude-rc" automatic-rename off
    tmux set-window-option -t "$site:claude-rc" allow-rename off
    tmux set-window-option -t "$site:claude-rc" remain-on-exit on

    if [[ -z "$clbin" ]]; then
        warn="claude not found on PATH — remote-control not started. Add ~/.local/bin to PATH."
        echo "site-tmux: $warn" >&2
        tmux send-keys -t "$site:claude-rc" "echo '$warn'" Enter
    elif dir_trusted "$dir"; then
        tmux send-keys -t "$site:claude-rc" \
            "exec '$clbin' remote-control --name '$site' --debug-file '$rclog/$site-rc.log'" Enter
    else
        warn="workspace not trusted — run  claude  in $dir once to accept the trust dialog, then re-run  site-tmux $site"
        echo "site-tmux: $warn" >&2
        # No exec: leave a live shell so the instruction stays visible in the window.
        tmux send-keys -t "$site:claude-rc" "echo 'site-tmux: $warn'" Enter
    fi
fi

exec tmux attach-session -t "$site"
